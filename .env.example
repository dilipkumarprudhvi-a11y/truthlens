# =========================================================
# TruthLens AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# =========================================================

# Application Environment
ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & CORS
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://dilipkumarprudhvi-a11y.github.io,https://truthlens-ai.vercel.app

# Input Limits
MAX_TEXT_LENGTH=25000
MAX_UPLOAD_SIZE_BYTES=5242880
URL_FETCH_TIMEOUT_SECONDS=5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Database Configuration
# Local SQLite default: sqlite:///./history.db
# Production PostgreSQL example: postgresql+psycopg2://user:password@host:5432/truthlens
DATABASE_URL=sqlite:///./history.db

# Evidence Retrieval Providers (Optional API Keys)
# Google Fact Check Tools API Key (leave empty for public fallback providers)
GOOGLE_FACTCHECK_API_KEY=

# DuckDuckGo search rate limits / timeouts (seconds)
SEARCH_TIMEOUT_SECONDS=5

# OCR Configuration (Tesseract binary path if not in system PATH)
TESSERACT_CMD=
